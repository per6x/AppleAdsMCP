# Copy to .env. Get these three values from Apple Ads > Account Settings > API.
APPLE_ADS_CLIENT_ID=SEARCHADS.replace-me
APPLE_ADS_TEAM_ID=SEARCHADS.replace-me
APPLE_ADS_KEY_ID=replace-me
APPLE_ADS_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem

# Platform API v1 (default). Discover account IDs with GET /acls.
APPLE_ADS_ACCOUNT_ID=

# For Campaign Management API v5, change API to v5 and set an organization ID.
APPLE_ADS_API=v1
APPLE_ADS_ORG_ID=

# Optional alternative to the four signing credentials above: an existing token.
# This token cannot be refreshed; restart with a new one when it expires.
# APPLE_ADS_ACCESS_TOKEN=

# Timeout for each HTTP request, in milliseconds (default 30000).
APPLE_ADS_TIMEOUT_MS=30000
